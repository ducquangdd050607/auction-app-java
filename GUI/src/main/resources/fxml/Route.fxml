<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Slide 4: Login Screen -->

<StackPane prefHeight="330.0" prefWidth="476.0" style="-fx-background-color: #2E7D9B;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Route">

    <!-- Login card -->
    <VBox alignment="CENTER" maxHeight="480" maxWidth="476.0" prefHeight="346.0" prefWidth="476.0" spacing="20" style="-fx-background-color: #2E7D9B;">
        <padding><Insets bottom="40" left="60" right="60" top="40" /></padding>
         <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Logo" />

        <!-- Logo -->
        <StackPane alignment="TOP_LEFT" prefWidth="1" />

        <!-- Title -->
        <Label prefHeight="35.0" prefWidth="431.0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Bạn đăng nhập với tư cách là..." />
      <HBox prefHeight="56.0" prefWidth="356.0" spacing="10.0">
         <children>
         
              <!-- Confirm button -->
              <Button fx:id="btnBid" onAction="#handleBidder" prefHeight="36" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                        -fx-font-size: 14; -fx-font-weight: bold;                        -fx-cursor: hand; -fx-background-radius: 4;" text="Bidder" />
            <Button fx:id="btnSell" onAction="#handleSeller" prefHeight="36" prefWidth="120.0" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                        -fx-font-size: 14; -fx-font-weight: bold;                        -fx-cursor: hand; -fx-background-radius: 4;" text="Seller" />
            <Button fx:id="btnAd" onAction="#handleAdmin" onMouseClicked="#showPrivateKey" prefHeight="36" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                        -fx-font-size: 14; -fx-font-weight: bold;                        -fx-cursor: hand; -fx-background-radius: 4;" text="Admin" />
         </children>
      </HBox>

        <!-- Register link -->
        <HBox alignment="CENTER" spacing="4" />
         <Label fx:id="confirmRoute" alignment="CENTER" prefHeight="27.0" prefWidth="282.0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;                           -fx-cursor: hand;" />
         <TextField fx:id="txtPrivateKey" prefHeight="30" prefWidth="160" promptText="Input private key" style="-fx-background-radius: 4; -fx-font-size: 12;" visible="false" />

        <!-- Error label (hidden by default) -->
        <Label fx:id="lblError" style="-fx-text-fill: #FF8A80; -fx-font-size: 12;" visible="false" />
      <Button fx:id="btnConfirm" layoutX="188.0" layoutY="366.0" onAction="#handleConfirm" prefHeight="36" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                        -fx-font-size: 14; -fx-font-weight: bold;                        -fx-cursor: hand; -fx-background-radius: 4;" text="Xác nhận" />
      <Button fx:id="btnConfirmAd" onAction="#handleConfirmAd" prefHeight="36" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                        -fx-font-size: 14; -fx-font-weight: bold;                        -fx-cursor: hand; -fx-background-radius: 4;" text="Xác nhận" visible="false" />
    </VBox>

</StackPane>
