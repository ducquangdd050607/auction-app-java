<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Slide 9  → OPEN      (Electronics)  : Chưa bắt đầu, chưa có bidder
    Slide 10 → RUNNING   (Art)          : Đang diễn ra, có bidder, có giá hiện tại
    Slide 11 → FINISHED  (Accessory)    : Kết thúc, hết hạn đặt cược
    Slide 12 → CANCELED  (Electronics)  : Bị hủy
    Slide 13 → RUNNING   (Art) + Seller : Xem danh sách bidder
    Slide 14 → FINISHED  (Accessory) + Seller : Xem danh sách bidder
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AuctionDetailController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #2E7D9B;">
    <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>

    <top>
        <VBox spacing="4">
            <!-- Screen header -->
            <Label text="Bét88 Live Auction Services"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: rgba(255,255,255,0.4);"/>
            <BorderPane.margin><Insets bottom="10"/></BorderPane.margin>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">

            <!-- Status badge -->
            <StackPane alignment="CENTER_LEFT">
                <Label fx:id="lblStatus" text="OPEN"
                       style="-fx-background-color: #27AE60; -fx-text-fill: white;
                              -fx-font-size: 13; -fx-font-weight: bold;
                              -fx-background-radius: 4; -fx-padding: 4 12 4 12;"/>
            </StackPane>

            <!-- Category + Item name -->
            <Label fx:id="lblCategory" text="[Electronics]"
                   style="-fx-text-fill: #B0D8E8; -fx-font-size: 15;"/>
            <Label fx:id="lblItemName" text="Dép yên lãng"
                   style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>

            <!-- Extra info (warranty / artist) -->
            <Label fx:id="lblExtraInfo" text="Warranty info: 36 months"
                   style="-fx-text-fill: white; -fx-font-size: 14;"/>

            <!-- Starting price -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Giá khởi điểm:"
                       style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;"/>
                <Label fx:id="lblStartingPrice" text="36.000 đ"
                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Current bid (RUNNING / FINISHED / CANCELED only) -->
            <VBox fx:id="boxCurrentBid" spacing="6" visible="false" managed="false">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Người dẫn đầu:"
                           style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;"/>
                    <Label fx:id="lblTopBidder" text="Nguyễn Văn An"
                           style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Giá đấu hiện tại:"
                           style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;"/>
                    <Label fx:id="lblCurrentBid" text="1.200.000 đ"
                           style="-fx-text-fill: #FFE066; -fx-font-size: 16; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Open date (OPEN only) -->
            <HBox fx:id="boxOpenDate" spacing="8" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <Label text="Thời gian mở sàn:"
                       style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;"/>
                <Label fx:id="lblOpenDate" text="25/03/2026"
                       style="-fx-text-fill: white; -fx-font-size: 14;"/>
            </HBox>

            <!-- End date -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Thời gian kết thúc:"
                       style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;"/>
                <Label fx:id="lblEndDate" text="07/07/2026"
                       style="-fx-text-fill: white; -fx-font-size: 14;"/>
            </HBox>

            <!-- Cancellation / expiry notice -->
            <Label fx:id="lblNotice" text=""
                   visible="false" managed="false"
                   style="-fx-text-fill: #FF8A80; -fx-font-size: 13; -fx-font-style: italic;"/>

            <!-- Bid input (RUNNING, guest/user) -->
            <HBox fx:id="boxBidInput" spacing="10" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <TextField fx:id="txtBidAmount" promptText="Nhập giá đấu..."
                           prefWidth="200" prefHeight="34"
                           style="-fx-background-radius: 4; -fx-font-size: 14;"/>
                <Button text="Đặt cược" onAction="#handlePlaceBid"
                        prefWidth="100" prefHeight="34"
                        style="-fx-background-color: #FFE066; -fx-text-fill: #2E7D9B;
                               -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-background-radius: 4;"/>
            </HBox>

            <!-- Seller actions -->
            <HBox fx:id="boxSellerActions" spacing="14"
                  visible="false" managed="false">
                <Button text="Xem danh sách bidder" onAction="#handleViewBidders"
                        prefWidth="200" prefHeight="38"
                        style="-fx-background-color: white; -fx-text-fill: #2E7D9B;
                               -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 4;"/>
            </HBox>

        </VBox>
    </center>

    <!-- Back button -->
    <bottom>
        <HBox alignment="CENTER_LEFT">
            <Button text="← Quay lại" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #B0D8E8;
                           -fx-font-size: 13; -fx-cursor: hand; -fx-underline: true;"/>
        </HBox>
    </bottom>

</BorderPane>
