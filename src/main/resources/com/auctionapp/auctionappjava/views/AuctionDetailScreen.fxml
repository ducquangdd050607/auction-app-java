<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="562.0" prefWidth="806.0" style="-fx-background-color: #2E7D9B;" stylesheets="@../css/AuctionListAndDetailScreen.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.AuctionDetailController">
    <padding><Insets bottom="30" left="50" right="50" top="30" /></padding>

    <top>
        <VBox spacing="4">
            <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Bét88 Live Auction Services" />
         <Button fx:id="btnBack" alignment="TOP_LEFT" onAction="#handleBack" prefHeight="30.0" prefWidth="90.0" styleClass="underline-link" text="← Quay lại" />
            <Separator style="-fx-background-color: rgba(255,255,255,0.4);" />
            <BorderPane.margin><Insets bottom="10" /></BorderPane.margin>
        </VBox>
    </top>

    <bottom>
        <HBox alignment="CENTER" spacing="36.0">
         <Button fx:id="btnRanking" contentDisplay="CENTER" onAction="#handleRanking" prefHeight="36.0" prefWidth="120.0" styleClass="confirm-btn" text="BXH" HBox.hgrow="ALWAYS" />
         <Button fx:id="btnGamble" contentDisplay="CENTER" onAction="#handleBidding" prefHeight="36.0" prefWidth="120.0" styleClass="confirm-btn" text="Đặt cược" />
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </HBox>
    </bottom>
   <left>
        <VBox spacing="14" BorderPane.alignment="CENTER">

            <StackPane alignment="CENTER_LEFT" prefHeight="27.0" prefWidth="239.0">
                <Label fx:id="lblStatus" style="-fx-background-color: #27AE60; -fx-text-fill: white;                               -fx-font-size: 13; -fx-font-weight: bold;                               -fx-background-radius: 4; -fx-padding: 4 12 4 12;" text="[STATUS]" />
            </StackPane>
            <Label fx:id="lblItemName" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="[Name]" />

            <Label fx:id="lblCategory" style="-fx-text-fill: #B0D8E8; -fx-font-size: 15;" text="[TYPE]" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Giá khởi điểm:" />
                <Label fx:id="lblStartingPrice" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            </HBox>
         <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="134.0" spacing="8">
            <children>
               <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Giá hiện tại:" />
               <Label fx:id="lblCurrentPrice" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="280.0" spacing="8">
            <children>
               <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Bước giá:" />
               <Label fx:id="lblMinIncrement" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            </children>
         </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Thời gian kết thúc:" />
                <Label fx:id="lblEndDate" style="-fx-text-fill: white; -fx-font-size: 14;" />
            </HBox>
         <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="168.0" spacing="8">
            <children>
               <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Người dẫn đầu hiện tại:" />
               <Label fx:id="lblCurrentLeader" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            </children>
         </HBox>
         <HBox prefHeight="69.0" prefWidth="239.0">
            <children>
               <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="Mô tả: " />
               <Label fx:id="txtDescription" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            </children>
         </HBox>

        </VBox>
   </left>
   <right>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
             <StackPane prefHeight="200.0" prefWidth="200.0">
                 <children>
                     <ImageView fx:id="imgProduct" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
                     <ProgressIndicator fx:id="imgSpinner" maxHeight="75.0" maxWidth="75.0" style="-fx-progress-color: rgba(255, 255, 255, 0.8);" />
                     <Label fx:id="lblNoImage" style="-fx-text-fill: #B0D8E8; -fx-font-size: 15; -fx-text-alignment: center;" text="Sản phẩm này không có ảnh minh họa" visible="false" wrapText="true" />
                 </children>
             </StackPane>
         </children>
      </VBox>
   </right>

</BorderPane>
