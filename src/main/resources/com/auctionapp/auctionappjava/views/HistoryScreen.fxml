<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Slide 7: Danh sách phiên đấu giá -->

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;" stylesheets="@../css/AuctionListAndItemScreen.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.HistoryListController">
    <padding><Insets bottom="30" left="40" right="40" top="30" /></padding>

    <top>
        <VBox prefHeight="106.0" prefWidth="820.0" spacing="14" style="-fx-background-color: #2E7D9B; -fx-background-radius: 15;">
            <!-- Screen title -->
            <Label fx:id="txtHistory" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />

            <!-- Search + filter bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="41.0" prefWidth="726.0" spacing="10" style="-fx-background-color: #2E7D9B;">
                <TextField fx:id="txtSearch" prefHeight="32" prefWidth="231.0" promptText="Tìm kiếm phiên đấu giá..." style="-fx-background-radius: 4; -fx-font-size: 13;" />
                <ComboBox fx:id="cbFilterStatus" prefHeight="32" prefWidth="140" promptText="Trạng thái" style="-fx-font-size: 13;" />
            <ComboBox fx:id="cbType" layoutX="471.0" layoutY="14.0" prefHeight="32" prefWidth="140" promptText="Thể loại" style="-fx-font-size: 13;" />
                <Button onAction="#handleSearch" prefHeight="32" prefWidth="70" styleClass="confirm-btn" text="Tìm" />
            </HBox>
            <padding><Insets bottom="10.0" left="30.0" right="10.0" top="10.0" /></padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </VBox>
    </top>
   <center>
      <TableView fx:id="historyTable" prefHeight="394.0" prefWidth="820.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="clmBidderName" prefWidth="66.0" text="Tên Bidders" />
            <TableColumn fx:id="clmAuctionName" prefWidth="110.0" text="Tên sản phẩm" />
            <TableColumn fx:id="clmStatus" prefWidth="70.0" text="Trạng thái" />
            <TableColumn prefWidth="124.00003051757812" text="Gía tiền">
               <columns>
                  <TableColumn fx:id="clmStartingPrice" prefWidth="100.0" text="Khởi đầu" />
                  <TableColumn fx:id="clmBiddingMoney" prefWidth="124.00003051757812" text="Đã đặt" />
               </columns>
            </TableColumn>
            <TableColumn fx:id="clmBiddedTime" prefWidth="144.0001220703125" text="Thời điểm đặt" />
            <TableColumn fx:id="clmChoose" minWidth="0.0" prefWidth="20.0">
               <graphic>
                  <CheckBox mnemonicParsing="false" prefHeight="17.0" prefWidth="12.0" />
               </graphic>
            </TableColumn>
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" top="10.0" />
         </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>

</BorderPane>
