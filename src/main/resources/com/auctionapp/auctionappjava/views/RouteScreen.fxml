<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="330.0" prefWidth="476.0" style="-fx-background-color: #2E7D9B;" stylesheets="@../css/Route.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.RouteController">


    <VBox alignment="CENTER" maxHeight="480" maxWidth="476.0" prefHeight="346.0" prefWidth="476.0" spacing="20" style="-fx-background-color: #2E7D9B;">
        <padding><Insets bottom="40" left="60" right="60" top="40" /></padding>
         <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Logo" />

        <StackPane alignment="TOP_LEFT" prefWidth="1" />

        <Label prefHeight="35.0" prefWidth="431.0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Bạn đăng nhập với tư cách là..." />
      <HBox alignment="CENTER" prefHeight="85.0" prefWidth="356.0" spacing="10.0">
         <children>
         

              <Button fx:id="btnBid" onAction="#handleBidder" prefHeight="30.0" prefWidth="95.0" styleClass="confirm-btn" text="Bidder" />
            <Button fx:id="btnSell" onAction="#handleSeller" prefHeight="30.0" prefWidth="95.0" styleClass="confirm-btn" text="Seller" />
         </children>
      </HBox>


        <HBox alignment="CENTER" spacing="4" />
         <Label fx:id="confirmRoute" alignment="CENTER" prefHeight="27.0" prefWidth="282.0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;                           -fx-cursor: hand;" />


        <Label fx:id="lblError" style="-fx-text-fill: #FF8A80; -fx-font-size: 12;" visible="false" />
      <Button fx:id="btnConfirm" layoutX="188.0" layoutY="366.0" onAction="#handleConfirm" prefHeight="36" prefWidth="120" styleClass="confirm-btn" text="Xác nhận" />
    </VBox>

</StackPane>
