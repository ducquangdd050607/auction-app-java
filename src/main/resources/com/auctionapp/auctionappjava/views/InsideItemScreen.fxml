<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!-- Slide 13 / 14: Seller – xem danh sách người đặt cược -->

<BorderPane prefHeight="692.0" prefWidth="900" style="-fx-background-color: #2E7D9B;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.InsideItemController">
    <padding><Insets bottom="28" left="40" right="40" top="28" /></padding>

    <top>
        <VBox spacing="6.0">
            <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Bét88 Live Auction Services" />

            <!-- Auction summary row -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label fx:id="lblCategory" style="-fx-text-fill: #B0D8E8; -fx-font-size: 14;" text="[Type]" />
                <Label fx:id="lblItemName" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="[Name]" />
                <Label fx:id="lblStatus" style="-fx-background-color: #27AE60; -fx-text-fill: white;                               -fx-font-size: 12; -fx-font-weight: bold;                               -fx-background-radius: 4; -fx-padding: 3 10 3 10;" text="[STATUS]" />
            </HBox>
            <HBox spacing="12">
                <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 13;" text="Giá khởi điểm:" />
                <Label fx:id="lblStartingPrice" style="-fx-text-fill: white; -fx-font-size: 13;" />
                <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 13;" text="  |  Giá cao nhất:" />
                <Label fx:id="lblTopBid" style="-fx-text-fill: #FFE066; -fx-font-size: 13; -fx-font-weight: bold;" />
            <Label layoutX="117.0" layoutY="10.0" style="-fx-text-fill: #B0D8E8; -fx-font-size: 13;" text="  |  Bước giá:" />
            <Label fx:id="lblMinIncrement" layoutX="221.0" layoutY="10.0" style="-fx-text-fill: #FFE066; -fx-font-size: 13; -fx-font-weight: bold;" />
                <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 13;" text="  |  Người dẫn đầu:" />
                <Label fx:id="lblTopBidder" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
            </HBox>
         <HBox layoutX="10.0" layoutY="76.0" spacing="12">
            <children>
               <Label style="-fx-text-fill: #B0D8E8; -fx-font-size: 13;" text="Mô tả:" />
               <Label fx:id="lblDescription" style="-fx-text-fill: white; -fx-font-size: 13;" />
            </children>
         </HBox>

                     <Separator style="-fx-background-color: rgba(255,255,255,0.4);" />
            <BorderPane.margin><Insets bottom="8" /></BorderPane.margin>
        </VBox>
    </top>

    <!-- Bidder table -->
    <center>
        <TableView fx:id="tableBidders" style="-fx-background-color: #3A8DAD;                           -fx-table-cell-border-color: rgba(255,255,255,0.15);                           -fx-font-size: 13;">
            <BorderPane.margin><Insets bottom="16" top="10" /></BorderPane.margin>
            <columns>
                <TableColumn fx:id="colRank" prefWidth="50" text="#" />
                <TableColumn fx:id="colUsername" prefWidth="220" text="Tên người dùng" />
                <TableColumn fx:id="colBidAmount" prefWidth="180" text="Giá đặt (đ)" />
                <TableColumn fx:id="colBidTime" prefWidth="200.0" text="Thời gian đặt" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="36.0" prefWidth="386.0" spacing="12">
            <Button fx:id="btnBack" onAction="#handleBack" prefHeight="36" prefWidth="99.0" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                            -fx-font-size: 13; -fx-font-weight: bold;                            -fx-cursor: hand; -fx-background-radius: 4;" text="← Quay lại" />
         <Button layoutX="142.0" layoutY="10.0" onAction="#handleBidders" prefHeight="36" prefWidth="122.0" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                            -fx-font-size: 13; -fx-font-weight: bold;                            -fx-cursor: hand; -fx-background-radius: 4;" text="Quản lý Bidders" />
         <Button layoutX="10.0" layoutY="10.0" onAction="#handleRemove" prefHeight="36" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                            -fx-font-size: 13; -fx-font-weight: bold;                            -fx-cursor: hand; -fx-background-radius: 4;" text="Xóa sản phẩm" />
         <Pane prefHeight="36.0" prefWidth="118.0" HBox.hgrow="ALWAYS" />
         <Button fx:id="btnExportWinner" layoutX="10.0" layoutY="10.0" onAction="#handleExportWinner" prefHeight="36" prefWidth="218.0" style="-fx-background-color: white; -fx-text-fill: #2E7D9B;                            -fx-font-size: 13; -fx-font-weight: bold;                            -fx-cursor: hand; -fx-background-radius: 4;" text="Xuất thông báo người thắng" />
        </HBox>
    </bottom>

</BorderPane>
