<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Slide 8: Quản lý sản phẩm (Seller) -->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auctionapp.auctionappjava.controllers.ItemsManagerController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #2E7D9B;">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <top>
        <Label text="Bét88 Items Manager"
               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;">
            <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
        </Label>
    </top>

    <!-- Items list -->
    <center>
        <ListView fx:id="listItems"
                  onMouseClicked="#handleSelectItem"
                  style="-fx-background-color: transparent;
                         -fx-background-insets: 0;
                         -fx-control-inner-background: #3A8DAD;
                         -fx-font-size: 14; -fx-text-fill: white;">
            <BorderPane.margin><Insets top="10" bottom="20"/></BorderPane.margin>
        </ListView>
    </center>

    <!-- Bottom action buttons -->
    <bottom>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="Thêm sản phẩm" onAction="#handleAddItem"
                    prefWidth="160" prefHeight="44"
                    style="-fx-background-color: white; -fx-text-fill: #2E7D9B;
                           -fx-font-size: 14; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 6;"/>
            <Button text="Xóa sản phẩm" onAction="#handleDeleteItem"
                    prefWidth="160" prefHeight="44"
                    style="-fx-background-color: white; -fx-text-fill: #2E7D9B;
                           -fx-font-size: 14; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 6;"/>
        </HBox>
    </bottom>

</BorderPane>
