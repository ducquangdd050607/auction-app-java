<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.ChatbotController">
    <top>
        <VBox spacing="4" style="-fx-background-color: #2E7D9B;">
            <padding><Insets top="12" right="16" bottom="12" left="16" /></padding>
            <Label text="Trợ lý đấu giá" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Hỏi về đăng nhập, vai trò, tạo phiên, đặt giá, auto bid, ví và dashboard" style="-fx-text-fill: #E3F2FD;" />
        </VBox>
    </top>
    <center>
        <TextArea fx:id="txtConversation" editable="false" wrapText="true" />
    </center>
    <bottom>
        <HBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10" /></padding>
            <TextField fx:id="txtMessage" HBox.hgrow="ALWAYS" onAction="#handleSend" promptText="Nhập câu hỏi..." />
            <Button onAction="#handleSend" text="Gửi" />
            <Button onAction="#handleClear" text="Xóa" />
        </HBox>
    </bottom>
</BorderPane>
