                  <StackPane prefHeight="34.0" prefWidth="32.0">
                     <children>
                        <Button fx:id="notifier" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleNotify" prefHeight="28.0" prefWidth="11.0" style="-fx-font-weight: bold; -fx-text-fill: rgb(46, 125, 155);" styleClass="route-btn">
                           <graphic>
                              <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
                           </graphic>
                        </Button>
                        <Circle fx:id="notificationBadge" fill="DODGERBLUE" radius="4.0" stroke="TRANSPARENT" strokeType="INSIDE" style="-fx-fill: #FF0000;" StackPane.alignment="TOP_RIGHT">
                           <StackPane.margin>
                              <Insets right="6.0" top="10.0" />
                           </StackPane.margin>
                        </Circle>
                     </children>
                  </StackPane>
                  <Region layoutX="1044.0" layoutY="10.0" prefHeight="42.0" prefWidth="11.0" />
                  <Button fx:id="btnSignout" mnemonicParsing="false" onAction="#handleSignOut" prefHeight="39.0" prefWidth="74.0" styleClass="logout-btn" text="Sign out" />
                  <Button fx:id="btnExit" mnemonicParsing="false" onAction="#handleExit" prefHeight="39.0" prefWidth="62.0" styleClass="logout-btn" text="Exit" />
               </children>
            </HBox>
         </top>
      </BorderPane>
      <VBox fx:id="notificationPanel" alignment="TOP_CENTER" maxHeight="500.0" maxWidth="360.0" prefWidth="100.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);" StackPane.alignment="TOP_RIGHT">
         <StackPane.margin>
            <Insets right="60.0" top="50.0" />
         </StackPane.margin>
         <children>
            <HBox prefHeight="7.0" prefWidth="360.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label style="-fx-text-fill: #050505;" text="Thông báo">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Region prefHeight="30.0" prefWidth="196.0" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleCloseNotify" styleClass="close-noti-btn" text="X" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <ScrollPane fx:id="notiScrollPane" fitToWidth="true" minHeight="0.0" prefWidth="360.0" styleClass="noti-scroll">
               <content>
                  <VBox fx:id="notificationList" prefWidth="358.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
      <VBox alignment="BOTTOM_RIGHT" pickOnBounds="false" spacing="10.0" StackPane.alignment="BOTTOM_RIGHT">
         <children>
            <VBox fx:id="chatbotPanel" managed="false" maxHeight="430.0" maxWidth="340.0" minHeight="390.0" prefHeight="395.0" prefWidth="340.0" styleClass="chatbot-panel" visible="false">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="chatbot-header">
                     <children>
                        <Label styleClass="chatbot-title" text="Trợ lý đấu giá" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#toggleChatbot" styleClass="chatbot-close-btn" text="X" />
                     </children>
                  </HBox>
                  <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="270.0" styleClass="chatbot-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="chatMessagesBox" prefWidth="338.0" spacing="8.0" styleClass="chatbot-messages" />
                     </content>
                  </ScrollPane>
                  <VBox fx:id="quickQuestionsBox" spacing="6.0" styleClass="chatbot-quick-box" />
                  <HBox alignment="CENTER" spacing="8.0" styleClass="chatbot-input-row">
                     <children>
                        <TextField fx:id="chatInput" onAction="#sendChatMessage" promptText="Nhập câu hỏi..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#sendChatMessage" styleClass="chatbot-send-btn" text="Gửi" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Button fx:id="chatbotToggleButton" mnemonicParsing="false" onAction="#toggleChatbot" styleClass="chatbot-toggle-btn">
               <graphic>
                  <Pane prefHeight="44.0" prefWidth="64.0">
                     <children>
                        <SVGPath content="M8 26 C8 14 20 7 36 7 C52 7 62 14 62 26 C62 37 51 44 36 44 L25 44 L13 51 L17 40 C11 37 8 32 8 26 Z" styleClass="chatbot-bubble-icon" />
                        <SVGPath content="M24 25 A3 3 0 1 1 23.9 25 M35 25 A3 3 0 1 1 34.9 25 M46 25 A3 3 0 1 1 45.9 25" styleClass="chatbot-dot-icon" />
                     </children>
                  </Pane>
               </graphic>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
