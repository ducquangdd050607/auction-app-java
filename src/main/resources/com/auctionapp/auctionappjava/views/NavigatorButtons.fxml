<StackPane fx:id="rootStackPane" prefHeight="710.0" prefWidth="1220.0" stylesheets="@../css/Navigator.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.NavigatorController">
   <children>
      <BorderPane fx:id="mainBorderPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity">
         <left>
            <VBox alignment="CENTER" prefHeight="664.0" prefWidth="165.0" style="-fx-background-color: #1F5A73;" BorderPane.alignment="CENTER">
               <children>
                  <VBox fx:id="groupHome" alignment="CENTER" prefHeight="18.0" prefWidth="131.0" style="-fx-background-color: #1F5A73;">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#handleBackToDash" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Trang chủ" />
                        <Separator prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox fx:id="groupBidder" alignment="CENTER" prefHeight="17.0" prefWidth="195.0">
                     <children>
                        <Button fx:id="btnItemListBidder" mnemonicParsing="false" onAction="#handleItemsList" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Danh sách đấu giá" />
                        <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#handleHistory" prefHeight="0.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Lịch sử đấu giá" />
                        <Separator prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox fx:id="groupAdmin" alignment="CENTER" prefHeight="70.0" prefWidth="186.0">
                     <children>
                        <Button fx:id="btnItemListAdmin" mnemonicParsing="false" onAction="#handleItemsList" prefHeight="6.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Quản lý phiên đấu giá" />
                        <Button fx:id="btnGotoUsersManager" mnemonicParsing="false" onAction="#handleGotoUsersManager" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Quản lý Users" />
                        <Button fx:id="btnTransactionList" layoutX="10.0" layoutY="47.0" mnemonicParsing="false" onAction="#handleHistory" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Danh sách đặt cược" />
                        <Button fx:id="btnTrend" mnemonicParsing="false" onAction="#handleTrend" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Xu hướng" />
                        <Separator prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox fx:id="groupSeller" alignment="CENTER" prefHeight="69.0" prefWidth="82.0">
                     <children>
                        <Button fx:id="btnItemListSeller" mnemonicParsing="false" onAction="#handleItemsList" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Danh sách đấu giá" />
                        <Button fx:id="btnItemManager" layoutX="10.0" layoutY="28.0" mnemonicParsing="false" onAction="#handleItemsList" prefHeight="25.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Quản lý vật phẩm" />
                        <Separator prefWidth="200.0" />
                     </children>
                  </VBox>
                  <Region VBox.vgrow="ALWAYS" />
                  <VBox fx:id="groupAccount" alignment="CENTER" prefHeight="53.0" prefWidth="181.0">
                     <children>
                        <Separator prefWidth="200.0" />
                        <Button fx:id="setting" layoutX="10.0" layoutY="122.0" mnemonicParsing="false" onAction="#handleAccount" prefHeight="45.0" prefWidth="165.0" styleClass="nav-menu-btn" text="Tài khoản" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </left>
         <center>
            <AnchorPane prefHeight="664.0" prefWidth="1000.0" BorderPane.alignment="CENTER" />
         </center>
         <top>
            <HBox alignment="CENTER" prefHeight="42.0" prefWidth="1055.0" style="-fx-background-color: #2E7D9B;" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/IconApp.png" />
                     </image>
                  </ImageView>
                  <Pane prefHeight="42.0" prefWidth="10.0" />
                  <Label alignment="CENTER" contentDisplay="CENTER" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Blue88" textAlignment="CENTER" textFill="WHITE" />
                  <Region prefHeight="50.0" prefWidth="302.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="identity" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="26.0" prefWidth="91.0" style="-fx-font-weight: bold; -fx-text-fill: rgb(46, 125, 155);" styleClass="route-btn" text="&quot;for Route&quot;" />
