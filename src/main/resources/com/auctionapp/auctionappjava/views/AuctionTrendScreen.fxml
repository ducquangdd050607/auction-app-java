<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;" stylesheets="@../css/AuctionListAndDetailScreen.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.AuctionTrendController">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <top>
        <VBox prefHeight="96.0" prefWidth="820.0" spacing="14" style="-fx-background-color: #2E7D9B; -fx-background-radius: 15;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Xu hướng đấu giá" />
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblSummary" style="-fx-text-fill: white; -fx-font-size: 13;" text="Đang tải xu hướng..." />
            </HBox>
            <padding>
                <Insets bottom="10.0" left="30.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblTrends" prefHeight="420.0" prefWidth="820.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="clmItemName" prefWidth="115.0" text="Sản phẩm" />
                <TableColumn fx:id="clmCurrentPrice" prefWidth="107.0" text="Giá hiện tại" />
                <TableColumn fx:id="clmScore" prefWidth="67.0" text="Điểm" />
                <TableColumn fx:id="clmLabel" prefWidth="211.0" text="Nhãn" />
                <TableColumn fx:id="clmReason" prefWidth="318.0" text="Lý do" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
