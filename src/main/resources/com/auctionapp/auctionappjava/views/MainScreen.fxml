<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="620.0" prefWidth="920.0" stylesheets="@../css/MainScreen.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.MainController">
   <children>
       <ImageView fitHeight="621.0" fitWidth="921.0" pickOnBounds="true">
           <Image url="@../images/LoginBackground.png"/>
       </ImageView>
      <BorderPane prefHeight="590.0" prefWidth="880.0">

          <top>
              <HBox alignment="CENTER_RIGHT" prefHeight="42.0" prefWidth="922.0" style="-fx-background-color: rgb(0, 113, 166); -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="680.0" spacing="10.0">
                     <children>
                        <ImageView fitHeight="40.0" fitWidth="92.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/IconApp.png" />
                           </image>
                        </ImageView>
                        <Label alignment="CENTER" text="Hệ thống đấu giá trực tuyến Blue88" textFill="#ececec">
                           <font>
                              <Font name="System Bold" size="17.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Button fx:id="btnRegister" alignment="CENTER" contentDisplay="CENTER" onAction="#handleRegister" prefHeight="39.0" prefWidth="83.0" styleClass="nav-btn" text="Đăng kí" />
                  <Button fx:id="btnLogin" alignment="CENTER" contentDisplay="CENTER" onAction="#handleLogin" prefHeight="39.0" prefWidth="90.0" styleClass="nav-btn" text="Đăng nhập" />
                  <Button fx:id="btnExit" alignment="CENTER" contentDisplay="CENTER" layoutX="882.0" layoutY="12.0" onAction="#handleExit" prefHeight="39.0" prefWidth="66.0" styleClass="nav-btn" text="Thoát" />
               </children>
              </HBox>
          </top>

          <center>
              <VBox alignment="CENTER" prefHeight="535.0" prefWidth="810.0" spacing="30.0">
               <VBox style="-fx-background-color: rgba(255, 255, 255, 0.7); -fx-background-radius: 20;">
                  <children>
                     <HBox prefHeight="240.0" prefWidth="820.0">
                        <children>
                               <VBox alignment="CENTER_LEFT" prefHeight="240.0" prefWidth="470.0" spacing="8.0">
                                   <Label alignment="CENTER" style="-fx-text-fill: #1e1e1e; -fx-font-size: 35; -fx-font-weight: bold;" text="Blue88" textFill="#1e1e1ec7" />
                                   <Label alignment="CENTER" contentDisplay="CENTER" style="-fx-text-fill: #1e1e1e; -fx-font-size: 24;" text="Nhà cược 3 xu nhất Kivotos😭😭" textFill="#1e1e1e" />
                                  <Button fx:id="btnExplore" alignment="CENTER" contentDisplay="CENTER" onAction="#handleLogin" prefHeight="46.0" prefWidth="176.0" styleClass="explore-btn" text="Khám phá ngay!">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Button>
                               </VBox>
                        </children>
                        <VBox.margin>
                           <Insets left="40.0" right="40.0" />
                        </VBox.margin>
                     </HBox>
                  </children>
                  <VBox.margin>
                     <Insets />
                  </VBox.margin>
                  <effect>
                     <DropShadow height="25.73" radius="8.842500000000001" width="11.64" />
                  </effect>
               </VBox>
              </VBox>
          </center>
      
      </BorderPane>
   </children>
</StackPane>
