<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.controllers.MainController">

    <!-- ===== NAVBAR TOP ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="12" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="8" left="16" right="16" top="8" /></padding>

            <!-- Logo -->
            <StackPane prefHeight="48" prefWidth="48" style="-fx-background-color: #2E7D9B; -fx-background-radius: 24;">
                <Label style="-fx-text-fill: white; -fx-font-size: 11;" text="Logo" />
            </StackPane>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Guest: Login + Register buttons -->
            <HBox fx:id="guestNavBox" alignment="CENTER" spacing="8">
                <Button fx:id="btnLogin" onAction="#handleLogin" prefHeight="34" prefWidth="90" style="-fx-background-color: #2E7D9B; -fx-text-fill: white;                                -fx-font-size: 13; -fx-cursor: hand;                                -fx-background-radius: 4;" text="Log in" />
            </HBox>

            <!-- Logged-in: User avatar/name circle -->
            <StackPane fx:id="userNavBox" managed="false" prefHeight="48" prefWidth="48" style="-fx-background-color: #2E7D9B; -fx-background-radius: 24;                               -fx-cursor: hand;" visible="false">
                <Label fx:id="lblUserAvatar" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" text="U" />
            </StackPane>
        </HBox>
    </top>

    <!-- ===== CENTER HERO ===== -->
    <center>
        <VBox alignment="CENTER" spacing="40">
            <!-- Hero banner -->
            <StackPane prefHeight="260" prefWidth="620" style="-fx-background-color: #2E7D9B; -fx-background-radius: 8;">
                <VBox alignment="CENTER_LEFT" spacing="10">
                    <padding><Insets left="40" /></padding>
                    <Label style="-fx-text-fill: white; -fx-font-size: 38; -fx-font-weight: bold;" text="Bét88" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 26;" text="Nhà cược 3 xu nhất vn" />
                </VBox>
            </StackPane>

            <!-- Bottom action buttons -->
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#handleAboutUs" prefHeight="45" prefWidth="200" style="-fx-background-color: #2E7D9B; -fx-text-fill: white;                                -fx-font-size: 15; -fx-cursor: hand;                                -fx-background-radius: 6;" text="(?)Về chúng tôi" />
                <!-- Seller only: Quản lý sản phẩm -->
                <Button fx:id="btnManageProducts" managed="false" onAction="#handleManageProducts" prefHeight="45" prefWidth="200" style="-fx-background-color: #2E7D9B; -fx-text-fill: white;                                -fx-font-size: 15; -fx-cursor: hand;                                -fx-background-radius: 6;" text="Quản lý sản phẩm" visible="false" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
