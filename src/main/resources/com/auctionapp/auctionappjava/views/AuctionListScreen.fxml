<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Slide 7: Danh sách phiên đấu giá -->

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;" stylesheets="@../css/AuctionListAndDetailScreen.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionapp.auctionappjava.client.controllers.AuctionListController">
    <padding><Insets bottom="30" left="40" right="40" top="30" /></padding>

    <top>
        <VBox prefHeight="106.0" prefWidth="820.0" spacing="14" style="-fx-background-color: #2E7D9B; -fx-background-radius: 15;">
            <!-- Screen title -->
            <Label fx:id="txtVersatile" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />

            <!-- Search + filter bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="41.0" prefWidth="726.0" spacing="10" style="-fx-background-color: #2E7D9B;">
                <TextField fx:id="txtSearch" prefHeight="32" prefWidth="231.0" promptText="Tìm kiếm phiên đấu giá..." style="-fx-background-radius: 4; -fx-font-size: 13;" />
                <ComboBox fx:id="cbFilterStatus" prefHeight="32" prefWidth="140" promptText="Trạng thái" style="-fx-font-size: 13;" />
            <ComboBox fx:id="cbType" layoutX="471.0" layoutY="14.0" prefHeight="32" prefWidth="140" promptText="Thể loại" style="-fx-font-size: 13;" />
                <Button fx:id="btnSearch" onAction="#handleSearch" prefHeight="32" prefWidth="70" styleClass="confirm-btn" text="Tìm" />
            <Button fx:id="btnReload" onAction="#handleReload" style="-fx-background-color: transparent; -fx-text-fill: #B0D8E8;                            -fx-font-size: 13; -fx-cursor: hand; -fx-underline: true;" text="Tải lại" />
            </HBox>
            <padding><Insets bottom="10.0" left="30.0" right="10.0" top="10.0" /></padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </VBox>
    </top>
   <center>
      <TableView fx:id="listAuctions" prefHeight="394.0" prefWidth="820.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="clmType" prefWidth="66.0" text="Thể loại" />
            <TableColumn fx:id="clmName" prefWidth="110.0" text="Tên" />
            <TableColumn fx:id="clmStatus" prefWidth="70.0" text="Trạng thái" />
            <TableColumn fx:id="clmBiddingMoney" prefWidth="124.00003051757812" text="Gía tiền đã đặt" visible="false" />
            <TableColumn fx:id="clmCurrentPrice1" prefWidth="124.00003051757812" text="Gía tiền">
               <columns>
                  <TableColumn fx:id="clmCurrentPrice" prefWidth="100.0" text="Hiện tại" />
                  <TableColumn fx:id="clmStartPrice" prefWidth="100.0" text="Khởi đầu" />
                  <TableColumn fx:id="clmMinIncrement" prefWidth="100.0" text="Bước giá" />
               </columns>
            </TableColumn>
            <TableColumn fx:id="clmBiddedTime" prefWidth="144.0001220703125" text="Thời điểm đặt" visible="false" />
            <TableColumn fx:id="clmTime" prefWidth="109.0" text="Thời gian còn lại" />
            <TableColumn fx:id="clmBidders" prefWidth="131.0" text="Số Bidders quan tâm" />
            <TableColumn fx:id="clmTrendsPoint" prefWidth="94.0" text="Điểm Trends" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" top="10.0" />
         </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox fx:id="box" alignment="CENTER" prefHeight="35.0" prefWidth="612.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="35.0" prefWidth="619.0" spacing="20.0" style="-fx-background-color: #2E7D9B; -fx-background-radius: 5;">
               <children>
                  <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#handleAdd" styleClass="confirm-btn" text="Thêm sản phẩm" />
                  <Button fx:id="btnRemove" layoutX="67.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleRemove" styleClass="confirm-btn" text="Xóa sản phẩm" />
                  <Button fx:id="btnCancel" layoutX="345.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleCancel" styleClass="confirm-btn" text="Hủy bỏ" />
               </children>
            </HBox>
         </children>
      </HBox>
   </bottom>

</BorderPane>
