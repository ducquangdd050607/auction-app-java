<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionhub.client.controller.LoginController" styleClass="app-root">
    <children>
        <VBox spacing="14" maxWidth="420" styleClass="card">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>
            <Label text="AuctionHub" styleClass="app-title"/>
            <Label text="Đấu giá trực tuyến • JavaFX Client" styleClass="subtitle"/>
            <TextField fx:id="usernameField" promptText="Username"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <Button text="Đăng nhập" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button"/>
            <Hyperlink text="Chưa có tài khoản? Đăng ký" onAction="#openRegister"/>
            <Label fx:id="statusLabel" text="Nhập tài khoản mẫu hoặc tài khoản tự tạo để bắt đầu." wrapText="true"/>
            <ProgressIndicator fx:id="loadingIndicator" prefWidth="28" prefHeight="28" visible="false"/>
            <Label text="Demo: admin/admin123 • seller1/seller123 • bidder1/bidder123" styleClass="hint" wrapText="true"/>
        </VBox>
    </children>
</StackPane>
