<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionhub.client.controller.RegisterController" styleClass="app-root">
    <children>
        <VBox spacing="12" maxWidth="480" styleClass="card">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <Label text="Tạo tài khoản mới" styleClass="app-title"/>
            <TextField fx:id="usernameField" promptText="Username"/>
            <TextField fx:id="fullNameField" promptText="Họ tên"/>
            <TextField fx:id="emailField" promptText="Email"/>
            <ComboBox fx:id="roleComboBox" promptText="Vai trò"/>
            <PasswordField fx:id="passwordField" promptText="Mật khẩu"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu"/>
            <Button text="Đăng ký" onAction="#handleRegister" maxWidth="Infinity" styleClass="primary-button"/>
            <Hyperlink text="Quay lại login" onAction="#backToLogin"/>
            <Label fx:id="statusLabel" text="Seller có thể tạo phiên đấu giá, Bidder có thể đặt giá." wrapText="true"/>
            <ProgressIndicator fx:id="loadingIndicator" prefWidth="28" prefHeight="28" visible="false"/>
        </VBox>
    </children>
</StackPane>
